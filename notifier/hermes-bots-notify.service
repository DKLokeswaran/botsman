[Unit]
Description=Hermes Bots notifier
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hermes-bots/notifier.env
ExecStart=/usr/bin/python3 %h/hermes-bots/notifier/hermes_notify.py --env-file %h/.config/hermes-bots/notifier.env
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
