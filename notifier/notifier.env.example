# Copy to notifier.env and fill in. notifier.env is gitignored.
# The password stays in this file on devbox. Do not commit it.

HERMES_URL=http://100.113.35.96:9119
HERMES_USERNAME=
HERMES_PASSWORD=
HERMES_PROVIDER=basic

# ntfy topic URL, or the UnifiedPush endpoint shown in the Android app.
NOTIFY_URL=http://127.0.0.1:8090/hermes-bots
# Optional ntfy access token. Leave empty for an open topic.
NOTIFY_TOKEN=

# The process binds its health port to this address and nowhere else.
# Use the devbox Tailscale address. It will not fall back to 0.0.0.0.
BIND_HOST=100.113.35.96
BIND_PORT=9191
POLL_SECONDS=5
