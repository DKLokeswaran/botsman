# systemd user unit for the Botsman server. install.sh fills in @NODE@ and @REPO@.
[Unit]
Description=Botsman server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@/server
ExecStart=@NODE@ src/main.ts
Environment=BOTSMAN_HOST=127.0.0.1
Environment=BOTSMAN_PORT=7600
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
