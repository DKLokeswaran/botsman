# systemd user unit for the Botsman server. install.sh fills in the @...@ values, for the real server or a preview.
[Unit]
Description=@DESCRIPTION@
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@/server
ExecStart=@NODE@ src/main.ts
Environment=BOTSMAN_HOST=127.0.0.1
Environment=BOTSMAN_PORT=@PORT@
Environment=BOTSMAN_DATA_DIR=@DATA_DIR@
Environment=BOTSMAN_BACKUP_DIR=@BACKUP_DIR@
Environment=BOTSMAN_COMMIT=@COMMIT@
Environment=BOTSMAN_BRANCH=@BRANCH@
Environment=BOTSMAN_PREVIEW=@PREVIEW@
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
