{
  "name": "hermes-bots-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && node --test contrast.regression.test.mjs",
    "test": "vitest run && node --experimental-strip-types --test test/chat-scroll.test.ts test/session-sync.test.ts",
    "tauri": "tauri",
    "e2e:serve": "vite build --config e2e/vite.config.ts --mode e2e && vite preview --config e2e/vite.config.ts --mode e2e --host 127.0.0.1 --port 4173 --strictPort",
    "e2e": "node e2e/assert-shipped-bundle.mjs && tsc -p e2e/tsconfig.json --noEmit && playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@hermes-bots/gateway-client": "file:../../contract/ts",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-websocket": "^2.4.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
