{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Botsman",
  "version": "0.1.4",
  "identifier": "dev.botsman.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Botsman",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDQUZERDU4NTFDNzZERDgKUldUWWJjZFJXTjJ2YkpvbjNSVWlKYm8zcWRHS2IyTjJqTmlKVkJzY1B0UGtSSTB3Vjc2bE83ZFcK",
      "endpoints": ["https://github.com/DKLokeswaran/botsman/releases/download/updates/windows.json"]
    }
  }
}
