{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "constants.ts",
    "helpers.ts",
    "contrast.ts",
    "shims/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
