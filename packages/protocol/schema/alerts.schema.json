{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://botsman.local/schema/alerts.schema.json",
  "title": "Botsman alerts stream",
  "$defs": {
    "Alert": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval",
            "question",
            "routine_result",
            "failure",
            "channel_mention",
            "routine_created",
            "skill_created"
          ]
        },
        "botId": {
          "type": "string"
        },
        "refId": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "botId",
        "refId",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "AlertsClientMessage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "hello"
            },
            "token": {
              "type": "string"
            },
            "epoch": {
              "type": "string"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "token",
            "epoch",
            "seq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ping"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AlertsServerMessage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "alert"
            },
            "epoch": {
              "type": "string"
            },
            "seq": {
              "type": "integer"
            },
            "alert": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "approval",
                    "question",
                    "routine_result",
                    "failure",
                    "channel_mention",
                    "routine_created",
                    "skill_created"
                  ]
                },
                "botId": {
                  "type": "string"
                },
                "refId": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "kind",
                "botId",
                "refId",
                "createdAt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "epoch",
            "seq",
            "alert"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "reset"
            },
            "epoch": {
              "type": "string"
            },
            "seq": {
              "type": "integer"
            }
          },
          "required": [
            "type",
            "epoch",
            "seq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ready"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pong"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "error"
            },
            "error": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "error",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
